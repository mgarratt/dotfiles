{
  "permissions": {
    "allow": [
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(* --help *)",
      "Bash(whoami)",
      "Bash(id *)",
      "Bash(hostname)",
      "Bash(uname *)",
      "Bash(uptime)",
      "Bash(date)",
      "Bash(date +*)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(file *)",
      "Bash(type *)",
      "Bash(command -v *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(mise ls)",
      "Bash(mise ls *)",
      "Bash(mise current *)",
      "Bash(mise doctor)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "fc-prodeng": {
      "source": {
        "source": "github",
        "repo": "FundingCircle/prodeng-skills"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "showTurnDuration": true,
  "enabledPlugins": {
    "sdlc@fc-prodeng": true
  }
}
