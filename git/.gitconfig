# Shared, machine-independent git config (managed by dotfiles).
# Per-machine identity (email, work conditional-includes) lives in
# ~/.gitconfig.local, pulled in by the [include] below — later entries win.
[user]
	name = Mark Garratt
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
# git-delta pager (installed via mise). Assumes delta is on PATH.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[include]
	path = ~/.gitconfig.local
