# Never commit the age private key or any decrypted plaintext secrets.
# (The *encrypted* zsh/.zsh/secrets.enc.env IS committed.)
keys.txt
*.age
*.dec
secrets.env
zsh/.zsh/secrets.env

# Claude Code writes its live runtime state into ~/.claude. With stow's --no-folding
# that stays in $HOME, but if folding ever regresses these would land in the repo.
# Allowlist only the files this package manages so nothing else — above all
# .credentials.json — can ever be committed.
/claude/.claude/*
!/claude/.claude/settings.json
!/claude/.claude/CLAUDE.md
!/claude/.claude/hooks/
